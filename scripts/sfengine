#!/usr/bin/env bash
# sfengine: short alias for generate_rule.py (the SentinelForge autonomous rule engine).
# Passes all arguments through. Activates the project venv if one exists.
# SF_LAB_DIR overrides the project directory (default: the repo containing this script).
set -e
SF_LAB_DIR="${SF_LAB_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$SF_LAB_DIR"
if [ -f "venv/bin/activate" ]; then
    # shellcheck disable=SC1091
    source venv/bin/activate
elif [ -f "venv/Scripts/activate" ]; then
    # shellcheck disable=SC1091
    source venv/Scripts/activate
fi
exec python generate_rule.py "$@"
