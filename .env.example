# Copy to .env and fill in. Never commit .env.
ELASTIC_URL=https://elastic.example.internal:9200
ELASTIC_API_KEY=
KIBANA_URL=https://kibana.example.internal:5601
# Set to 1 ONLY for a lab with self-signed certs (disables TLS verification, logs a warning)
LAB_INSECURE_TLS=0
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Threat-intel lookups (sf_hunt.py). Each source is skipped, not failed, when its key is unset. ---
# ABUSEIPDB_API_KEY=
# GREYNOISE_API_KEY=
# VIRUSTOTAL_API_KEY=
# OTX_API_KEY=
# abuse.ch key: unlocks URLhaus, MalwareBazaar, ThreatFox, SSLBL
# ABUSECH_AUTH_KEY=
# Comma-separated IPs of your own hosts, excluded from enrichment (default: none)
# SF_SELF_IPS=

# --- Optional. Uncomment only if you need them: an empty value is NOT the same as unset. ---
# Web dashboard: required to enable approve/reject (sent as X-Admin-Token). Unset = those routes are
# disabled. Must be at least 16 characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# LAB_ADMIN_TOKEN=
# Comma-separated Host headers the web app accepts (default: localhost,127.0.0.1,testserver)
# SF_ALLOWED_HOSTS=
# Web hunt rate limit: requests per window in seconds (defaults: 10 per 60)
# SF_HUNT_RATE_LIMIT=10
# SF_HUNT_RATE_WINDOW=60
# Failed approve/reject attempts per window in seconds before a client is locked out (defaults: 5 per 300)
# SF_AUTH_FAIL_LIMIT=5
# SF_AUTH_FAIL_WINDOW=300
# Project root used by scripts/ and scheduler/ (defaults to the script's own directory)
# SF_LAB_DIR=
# Log directory for run_*.sh (defaults to $SF_LAB_DIR/logs)
# SF_LOG_DIR=
# Model used for rule generation, validation and healing (each script has a default)
# MODEL_NAME=
# Ollama voter in validate_rule.py (defaults: http://localhost:11434 and qwen2.5:14b)
# OLLAMA_URL=
# OLLAMA_MODEL=
# Author written into generated rules (default: SentinelForge)
# SF_AUTHOR=
# SF_REPO_URL=
# Restrict rule generation to one host.name (default: * = all hosts)
# TARGET_HOST=
# "true" queues generated rules for human approval instead of publishing them. Off by default.
# WATER_REVIEW_GATE=true
# "true" pauses the whole rule engine before any query or generation
# STOP_SF_ENGINE=false
# Set to 0 to turn off case-variant expansion of generated queries (debugging only; default on)
# SF_CASE_VARIANTS=1
